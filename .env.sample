RESEND_API_KEY=
SERVER_PORT=
RUBIX_NODE_URL=
EMAIL_FROM=
DATABASE_URL=
# Dashboard origins allowed to call the API with the session cookie (comma-separated)
CORS_ALLOWED_ORIGINS=
# lax (default) | strict | none
SESSION_COOKIE_SAMESITE=
# true (default); false only for plain-http local dev
SESSION_COOKIE_SECURE=
SESSION_COOKIE_DOMAIN=
ORG_ID=
ADMIN_SERVICE_URL=
CBAC_SERVICE_URL=
CREATE_AGENT_ENDPOINT=
UPDATE_AGENT_ENDPOINT=
# Warning 5108: a credential first used longer ago than this is flagged.
# Days (90d) or a Go duration (2160h). Empty turns 5108 off.
DURATION_CREDENTIAL=
# Warning 5107: a key with more rejected requests than this is flagged
# automatically. A whole number; empty or 0 turns auto-flagging off.
CREDENTIAL_REJECTION_LIMIT=
