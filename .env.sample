SERVER_PORT=
RUBIX_NODE_URL=

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/agentdna?sslmode=disable

# Shared HS256 secret used to sign and verify JWTs.
# Must match the JWT_SECRET on the admin server so tokens issued there
# are accepted by this middleware's JWTAuthMiddleware.
JWT_SECRET=change-me-to-a-strong-random-secret

# Email sending (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="noreply@yourdomain.io"

# Admin service base URL (must end with a trailing slash).
# Used for register-admin, create-agent, update-agent-policies and authorize-action.
ADMIN_SERVICE_URL=
CREATE_AGENT_ENDPOINT=
UPDATE_AGENT_ENDPOINT=
