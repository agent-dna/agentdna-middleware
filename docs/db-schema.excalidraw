   "roundness": null,
   "seed": 573124783,
   "version": 1,
   "versionNonce": 53554862,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Concurrent DDL (DROP/ADD PK, CREATE OR REPLACE FUNCTION, user_dids conversion) can fail with 'tuple concurrently updated' or deadlock.\nFix: take pg_advisory_lock(<const>) at the start of New() and release at the end, or move to a versioned migration tool (goose/golang-migrate).",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Concurrent DDL (DROP/ADD PK, CREATE OR REPLACE FUNCTION, user_dids conversion) can fail with 'tuple concurrently updated' or deadlock.\nFix: take pg_advisory_lock(<const>) at the start of New() and release at the end, or move to a versioned migration tool (goose/golang-migrate).",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el274",
