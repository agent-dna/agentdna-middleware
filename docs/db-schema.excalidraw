   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "DELETE duplicates + DROP PK + ADD PK each start: full table lock and index rebuild, and a window with no uniqueness. Wrap in an IF NOT EXISTS check like new_org_users does.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "DELETE duplicates + DROP PK + ADD PK each start: full table lock and index rebuild, and a window with no uniqueness. Wrap in an IF NOT EXISTS check like new_org_users does.",
   "lineHeight": 1.25,
   "autoResize": true
  },
