  {
   "id": "el273",
   "type": "text",
   "x": 100,
   "y": 1411.0,
   "width": 1115.3999999999999,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
