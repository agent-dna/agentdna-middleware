   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "threats, interactions, pending_branches, sessions etc. are linked only logically, so deletes/rollbacks can leave orphans (e.g. threats of a rolled-back intent). threats has no index on intent_id/interaction_id.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "threats, interactions, pending_branches, sessions etc. are linked only logically, so deletes/rollbacks can leave orphans (e.g. threats of a rolled-back intent). threats has no index on intent_id/interaction_id.",
   "lineHeight": 1.25,
   "autoResize": true
  },
