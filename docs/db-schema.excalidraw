   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "New() never sets SetMaxOpenConns/SetConnMaxLifetime (txnsim does), so a traffic spike can exhaust Postgres max_connections. log.Fatal kills the process with no cleanup.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "New() never sets SetMaxOpenConns/SetConnMaxLifetime (txnsim does), so a traffic spike can exhaust Postgres max_connections. log.Fatal kills the process with no cleanup.",
   "lineHeight": 1.25,
   "autoResize": true
  }
