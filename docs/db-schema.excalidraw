   "versionNonce": 75181073,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "new_org_users.did defaults 'none' (CREATE says ''), many users share it. Any query 'WHERE did = $1' called with 'none' matches all DID-less users.\nThe user_dids trigger filters these, other queries may not. Prefer NULL for 'no DID yet'.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "new_org_users.did defaults 'none' (CREATE says ''), many users share it. Any query 'WHERE did = $1' called with 'none' matches all DID-less users.\nThe user_dids trigger filters these, other queries may not. Prefer NULL for 'no DID yet'.",
   "lineHeight": 1.25,
   "autoResize": true
  },
