   "versionNonce": 1140563901,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "JOIN new_admins a2 ON a2.name = a1.name, with no organization filter. Two admins both called 'admin' (or the same person in two orgs)\nget each other's DIDs, so user-scoped queries return the other admin's agents, intents and threats. Fix: join on a stable admin-server user id + org.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "JOIN new_admins a2 ON a2.name = a1.name, with no organization filter. Two admins both called 'admin' (or the same person in two orgs)\nget each other's DIDs, so user-scoped queries return the other admin's agents, intents and threats. Fix: join on a stable admin-server user id + org.",
   "lineHeight": 1.25,
   "autoResize": true
  },
