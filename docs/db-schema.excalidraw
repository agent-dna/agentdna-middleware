   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Logins only TrimSpace the email (otp_login.go:95), so 'Hari@x.com' and 'hari@x.com' become two users / a login 'not registered'. Fix: lower() on write+read, or CITEXT / UNIQUE(lower(email)).",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Logins only TrimSpace the email (otp_login.go:95), so 'Hari@x.com' and 'hari@x.com' become two users / a login 'not registered'. Fix: lower() on write+read, or CITEXT / UNIQUE(lower(email)).",
   "lineHeight": 1.25,
   "autoResize": true
  },
