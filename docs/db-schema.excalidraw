   "updated": 1,
   "link": null,
   "locked": false,
   "text": "apps table never queried; email_pk_added never read; intent_block_data still exists in old DBs (no DROP TABLE); ADD COLUMN name / created_at are no-ops (already in CREATE).\nthreat_codes seed uses ON CONFLICT DO NOTHING, so edited titles/descriptions never reach existing DBs.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "apps table never queried; email_pk_added never read; intent_block_data still exists in old DBs (no DROP TABLE); ADD COLUMN name / created_at are no-ops (already in CREATE).\nthreat_codes seed uses ON CONFLICT DO NOTHING, so edited titles/descriptions never reach existing DBs.",
   "lineHeight": 1.25,
   "autoResize": true
  },
